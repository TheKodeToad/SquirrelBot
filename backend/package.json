		"pg": "^8.16.0",
		"smol-toml": "^1.3.4",
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.29.0",
		"@swc-node/register": "^1.10.10",
		"@types/async-lock": "^1.4.2",
		"@types/node": "^24.0.1",
		"@types/pg": "^8.15.2",
		"eslint": "^9.29.0",
		"globals": "^16.2.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.34.1"
