{
	"name": "backend",
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"scripts": {
		"check": "eslint && tsc",
		"bot": "npm run _node src/bot/main.ts",
		"http": "npm run _node src/http/main.ts",
		"migrate": "npm run _node src/db/main.ts migrate --",
		"check-migrations": "npm run _node src/db/main.ts check --",
		"_node": "node --env-file=.env --disable-proto=throw --disallow-code-generation-from-strings --experimental-transform-types"
	},
	"dependencies": {
		"@hono/node-server": "^1.14.2",
		"@hono/valibot-validator": "^0.5.2",
		"async-lock": "^1.4.1",
		"hono": "^4.7.10",
		"oceanic-component-helper": "^1.0.1",
		"oceanic.js": "~1.12.0",
		"pg": "^8.16.0",
		"smol-toml": "^1.3.4",
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.27.0",
		"@types/async-lock": "^1.4.2",
		"@types/node": "^22.15.21",
		"@types/pg": "^8.15.2",
		"eslint": "^9.27.0",
		"globals": "^16.2.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.33.0"
	}
}
