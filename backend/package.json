{
	"name": "backend",
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"scripts": {
		"lint": "eslint && tsc",
		"bot": "pnpm run _node src/interface/discord/main.ts",
		"http": "pnpm run _node src/interface/http/main.ts",
		"migration": "pnpm run _node src/interface/migration/main.ts",
